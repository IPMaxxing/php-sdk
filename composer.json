{
    "name": "ipmax/ipmax",
    "description": "PHP client for the IP-Max GeoIP and IP intelligence API",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["ipmax", "geoip", "ip intelligence", "psr-18"],
    "homepage": "https://ipm.ax",
    "authors": [
        {
            "name": "IP-Max",
            "email": "opensource@ipm.ax"
        }
    ],
    "support": {
        "issues": "https://github.com/IPMaxxing/php-sdk/issues",
        "source": "https://github.com/IPMaxxing/php-sdk"
    },
    "require": {
        "php": "^8.2",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "guzzlehttp/guzzle": "^7.9",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Default PSR-18 client; the timeout option applies to it"
    },
    "autoload": {
        "psr-4": {
            "IPMax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IPMax\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "php-cs-fixer fix --dry-run --diff",
            "phpstan analyse"
        ],
        "test": "phpunit"
    }
}
